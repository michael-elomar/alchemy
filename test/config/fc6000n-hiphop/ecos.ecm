cdl_savefile_version 1;
cdl_savefile_command cdl_savefile_version {};
cdl_savefile_command cdl_savefile_command {};
cdl_savefile_command cdl_configuration { description hardware template package };
cdl_savefile_command cdl_package { value_source user_value wizard_value inferred_value };
cdl_savefile_command cdl_component { value_source user_value wizard_value inferred_value };
cdl_savefile_command cdl_option { value_source user_value wizard_value inferred_value };
cdl_savefile_command cdl_interface { value_source user_value wizard_value inferred_value };

cdl_configuration eCos {
    description "" ;
    hardware    p6dev ;
    template    default ;
    package -template CYGPKG_HAL current ;
    package -template CYGPKG_IO current ;
    package -template CYGPKG_IO_SERIAL current ;
    package -template CYGPKG_INFRA current ;
    package -template CYGPKG_KERNEL current ;
    package -template CYGPKG_MEMALLOC current ;
    package -template CYGPKG_ISOINFRA current ;
    package -template CYGPKG_LIBC current ;
    package -template CYGPKG_LIBC_I18N current ;
    package -template CYGPKG_LIBC_SETJMP current ;
    package -template CYGPKG_LIBC_SIGNALS current ;
    package -template CYGPKG_LIBC_STARTUP current ;
    package -template CYGPKG_LIBC_STDIO current ;
    package -template CYGPKG_LIBC_STDLIB current ;
    package -template CYGPKG_LIBC_STRING current ;
    package -template CYGPKG_LIBC_TIME current ;
    package -template CYGPKG_LIBM current ;
    package -template CYGPKG_IO_WALLCLOCK current ;
    package -template CYGPKG_ERROR current ;
    package -hardware CYGPKG_HAL_ARM current ;
    package -hardware CYGPKG_HAL_ARM_ARM9 current ;
    package -hardware CYGPKG_HAL_ARM_ARM9_P6DEV current ;
    package -hardware CYGPKG_IO_SERIAL_ARM_P6DEV current ;
    package -hardware CYGPKG_IO_SERIAL_ARM_PARROT5 current ;
    package CYGPKG_RAMBOOT current ;
    package CYGPKG_UTILS current ;
    package CYGPKG_CRC current ;
    package CYGPKG_COMPRESS_ZLIB current ;
    package CYGPKG_IO_WATCHDOG current ;
    package CYGPKG_IO_P6_GPIO current ;
    package CYGPKG_DEVS_PARROT_TIMER current ;
    package CYGPKG_ACDC current ;
    package CYGPKG_IO_FILEIO current ;
    package CYGPKG_DEVICES_AAI_PARROT6I current ;
    package CYGPKG_IO_P5_AAI current ;
    package CYGPKG_IO_I2C current ;
    package CYGPKG_FS_PFFS current ;
    package CYGPKG_FS_RAM current ;
    package CYGPKG_IO_NAND_FLASH current ;
    package CYGPKG_DEVICES_NAND_BA315 current ;
    package CYGPKG_LIBSTDCXX current ;
};

cdl_option CYGBLD_GLOBAL_COMMAND_PREFIX {
    user_value arm-elf
};

cdl_option CYGBLD_GLOBAL_CFLAGS {
    user_value "-Wall -Wpointer-arith -Wstrict-prototypes -Wundef -Woverloaded-virtual -Wno-write-strings  -mno-thumb-interwork -mcpu=arm926ej-s -g -O2 -ffunction-sections -fdata-sections -fno-exceptions "
    value_source default
};

cdl_option CYGPKG_FS_PFFS_CFLAGS_ADD {
    user_value "-D__ECOS__ -DFC6000_USE_SUP_LOG_TASK_FOR_PRINTF"
};

cdl_option CYGNUM_KERNEL_SYNCH_MBOX_QUEUE_SIZE {
    user_value 20
};

cdl_option CYGBLD_GLOBAL_LDFLAGS {
    user_value "-mno-thumb-interwork -mcpu=arm926ej-s -Wl,--gc-sections -Wl,-static -g -nostdlib"
    value_source default
};

cdl_component CYGDBG_HAL_DIAG_TO_DEBUG_CHAN {
    user_value 0
};

cdl_option CYGIMP_HAL_COMMON_INTERRUPTS_IGNORE_SPURIOUS {
    user_value 1
};

cdl_option CYGDBG_HAL_DEBUG_GDB_THREAD_SUPPORT {
    user_value 0
};

cdl_option CYGBLD_HAL_ARM_EABI {
    user_value 0
};

cdl_option CYGHWR_HAL_ARM_DUMP_EXCEPTIONS {
    user_value 1
};

cdl_option CYGOPT_HAL_ARM_ECOS_ID {
    user_value 1
};

cdl_component CYG_HAL_STARTUP {
    user_value RAM
};

cdl_option CYGHWR_HAL_ARM_ARM9_P6DEV_SDRAM_SIZE {
    user_value 32
};

cdl_component CYGHWR_HAL_CUSTOM_CONFIG {
    user_value FC6000N
};

cdl_option CYGNUM_HAL_VIRTUAL_VECTOR_DEBUG_CHANNEL {
