cdl_component CYGPKG_INFRA_DEBUG {
    user_value 1
};

cdl_component CYGDBG_USE_ASSERTS {
    user_value 0
};

cdl_option CYGFUN_INFRA_EMPTY_DELETE_FUNCTIONS {
