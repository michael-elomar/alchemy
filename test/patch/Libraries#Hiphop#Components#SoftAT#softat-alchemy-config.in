
#----------------------------------------------------------
# Alchemy hooks.
#----------------------------------------------------------

config BUILD_TINYXML
	bool
	default y

config BUILD_BLUES
	bool
	default y

config BUILD_SOUL
	bool
	default y

config BUILD_CONCERTOS
	bool
	default y

config BUILD_DISCO
	bool
	default y

config BUILD_TANGO
	bool
	default y

config BUILD_TAMTAM
	bool
	default y

config BUILD_TALA
	bool
	default y

config BUILD_RAP
	bool "BUILD_RAP"
	default y

config BUILD_UPNP
	bool "BUILD_UPNP"
	default y

config BUILD_MODMAN
	bool "BUILD_MODMAN"
	default y

#----------------------------------------------------------
# Private config 
#----------------------------------------------------------
menu "Overwrite libraries config"
	
	config CK5050_USE_RAPTOR
	bool "Use Raptor"
	default y
	
	choice 
		prompt "Hardware"
		
		config CK5050_USE_P6_OR_P6i
		bool "Use P6 or P6i"
		
		config CK5050_USE_OMAP
		select CK5050_ENABLE_NEON_OPTIMIZATION
		bool "Use OMAP"
		
		config CK5050_USE_OTHERS
		bool "Use others"
					
	endchoice # Hardware
	
    menu "Voice Reco/TTS"
    depends on BUILD_RAP
        config CK5050_FEATURE_USE_RECO
            bool "Use Svox Reco"
            default y
            help
                Activate RAP_ENABLE_RECO flag

        config CK5050_FEATURE_USE_TTS
            bool "Use Parrot TTS"
            default n
            help
                Activate RAP_ENABLE_TTS flag

        config CK5050_USE_RECO_MULT
            bool "Activate Voice Reco on Multimedia."
            default y
            help
                Activate RAP_USE_DISCO flag

        config CK5050_USE_GRACENOTE
            depends on CK5050_USE_RECO_MULT
            bool "Use Gracenote"
            default y
            help
                Activate flags using gracenote in Rap and Disco
    endmenu # Rap
        
    menu "Disco input"
        config CK5050_FEATURE_USE_DISCO_USB
            bool "Activate USB in Disco"
            default y
            #select DISCO_ENABLE_MTP
            help
               "Enable/Disable support of USB keys in Disco."

        config CK5050_FEATURE_USE_DISCO_BSM
            bool "Activate BSM in Disco"
            default y
            #select DISCO_ENABLE_BSM
            help
               "Enable/Disable support of BSM devices in Disco."
    endmenu # Disco

	menu "Codecs" 
		config CK5050_USE_MP3_CODEC 
			depends on BUILD_BLUES || BUILD_TANGO
			bool "TANGO_BLUES_USE_MP3_CODEC"		
			default y 
			help 
				"Enable/Disable MP3 codec in Tango and Blues (when library to modify is activated)" 

		config CK5050_USE_AAC_CODEC 
			depends on BUILD_TANGO
			bool "TANGO_USE_AAC_CODEC"		
			default y 
			help 
				"Enable/Disable AAC codec in Tango (when library to modify is activated)" 

		config CK5050_USE_BLUES_AAC_CODEC 
			depends on BUILD_BLUES && (!BUILD_TANGO || (BUILD_TANGO && CK5050_USE_AAC_CODEC))
			bool "TANGO_BLUES_USE_AAC_CODEC"		
			default n 
			help 
				"Enable/Disable AAC codec in Blues (when library to modify is activated)" 

		config CK5050_USE_OGG_CODEC
			depends on BUILD_TANGO
			bool "TANGO_USE_OGG_CODEC"
			default y
			help 
				"Enable/Disable OGG codec in Tango (when library is activated)"

		config CK5050_USE_WMA_CODEC
			depends on BUILD_TANGO
			bool "TANGO_USE_WMA_CODEC"
			default y	
			help 
				"Enable/Disable WMA codec in Tango (when library is activated)"	
	endmenu #   Codecs
		
	menu "Blues"
	depends on BUILD_BLUES
	    config CK5050_USE_BLUES_SAFE_UPDATE
		bool "Use safe software update via Blues"
		default n
		help
			Overwrites the CONFIG_BLUES_SUPPORT_SAFEUPDATE_BLOCK in Blues config.

		config CK5050_ENABLE_BLUES_OBEX_OVER_L2CAP
		bool "Enable generic AMP and OBEX over L2CAP"
		default n
		help
			"Activate/Desactivate Generic AMP and OBEX over L2CAP in Blues.config."

		config CK5050_BLM_CLCC_MAX_USERS
		int "CK5050_BLM_CLCC_MAX_USERS"
		default 2
		help
			"Set the maximum number of connected phones"

		config CK5050_ENABLE_SUPPORT_SMS_BLOCK
	    bool "Enable support of SMS block by Blues"
	    default n
	    help
	    	"Activate support of SMS bu blues. When enabled, max number of simultaneous telephony users is set automatically to 1"

        config CK5050_ENABLE_SUPPORT_MULTI_HFP
	    depends on !CK5050_ENABLE_SUPPORT_SMS_BLOCK
	    bool "Enable support of Multi HFP"
	    default y
	    help
	    	"Activate support of Multi HFP."

	    config CONFIG_CK5050_ENABLE_BLUES_SUPPORT_IMG_INOPP 
	    bool "Enable support of sync of contact's images."
	    default y
 
	    config CK5050_SUPPORT_HID
	        bool "Enable support of HID profile"
	        default n
	        help
		        "Only available on Blues 7"
			
		if CK5050_SUPPORT_HID
			choice
				prompt "HID role"
				default CK5050_SUPPORT_HID_HOST
				help
				"Please select HID role.
				default is host mode"
			config CK5050_SUPPORT_HID_HOST
				bool "Host role"
			config CK5050_SUPPORT_HID_DEVICE
				bool "Device role"
			endchoice
		endif    	

		config CK5050_ENABLE_STREAMING_BLOCK
		bool "Enable support of streamnig block"
    	default y
    	help 
        	"Enable support of streamnig block(A2DP,AVRCP ..)"
 
    	if 	CK5050_ENABLE_STREAMING_BLOCK

	config CK5050_ENABLE_AVRCP
	bool "Enable support of AVRCP (target/controller)"
    	default y
    	help 
        	"Enable support of AVRCP (target/controller)"
 
    	if 	CK5050_ENABLE_AVRCP

        choice
        prompt "Choose your AVRCP type"
        default CK5050_ENABLE_BLUES_AVRCP_CONTROLLER_14
        
            config CK5050_ENABLE_BLUES_AVRCP_CONTROLLER_13
            depends on BUILD_DISCO
            bool "Enable AVRCP Controller 1.3"
            help
				"Activate/Desactivate AVRCP Controller version 1.3 in Blues and Disco config. To enable it check Libraries/Multimedia/Disco library"
            config CK5050_ENABLE_BLUES_AVRCP_CONTROLLER_14
            depends on BUILD_DISCO
            bool "Enable AVRCP Controller 1.4"
            help
				"Activate/Desactivate AVRCP Controller version 1.4 in Blues and Disco config. To enable it check Libraries/Multimedia/Disco library"
            config CK5050_ENABLE_BLUES_AVRCP_TARGET_14
            bool "Enable AVRCP Target 1.4"
            help
				"Activate/Desactivate AVRCP Target version 1.4 in Blues config"
        endchoice
        endif
			config CK5050_ENABLE_BLUES_STREAMING_SRC
			bool "Enable streaming src"
			default y 
			help 
				"Activate/Descativate BLUES_SUPPORT_STREAMING_SRC and BLUES_SUPPORT_STREAMING_SRC_TASK		
    	endif
  	    
	    config CK5050_ENABLE_BLUES_SYNCHRO_DEBUG 
            bool "Enable synchro debug in Blues."
	    default n

		config CK5050_ENABLE_BNEP_BLOCK
			depends on CK5050_SUPPORT_PAN
    	    bool "Enable support of BNEP block"
    	    default y
    	    help 
    	        "Enable support of BNEP block for PAN service"
	     
	endmenu #Blues

    menu "Tango"
    depends on BUILD_TANGO
        config CK5050_USE_FORCE_MMP_BUFFER_SIZE
        bool "Force MMP buffer size in Tala according to OS."
        default y
    
        config CK5050_USE_TANGO_MICRO_INVERSION
        bool "Micro inversion"
        default n
        help
            Overwrites the CONFIG_TANGO_VOICE_INVERT_MICROPHONE in Tango config.

        config CK5050_TANGO_BUILD_WIND_NOISE_REDUCTION
            bool "Build WNR module"
            default n
            help
                Overwrites the CONFIG_TANGO_BUILD_WIND_NOISE_REDUCTION in Tango config.
                Enable this flag to build Wind Noise Reduction module on TX.
                The WNR module remains deactivated by default even when the flag is activated.
                It must be enabled in the Tango XML config file for processing to occur.
            
	    config CK5050_USE_REMOTE_UI_INTERFACE
	    bool "Remote UI interface"
	    default n
	    help
	    	Overwrites the CONFIG_TANGO_ENABLE_REMOTE_UI_INTERFACE in Tango config.
	    	
	    config CK5050_ENABLE_NEON_OPTIMIZATION
	    bool "Enable Neon Optimization (necessary for omap products)"
	    default n
	    help
	    	Overwrites the CONFIG_TANGO_ENABLE_NEON_OPTIMIZATION in Tango config.	
	    	
	endmenu # Tango
	
	menu "Soul"
	depends on BUILD_SOUL
		config CK5050_SOUL_SUPPORT_SORTING_CHINESE
		bool "Make soul support the chinese sorting"
		default n 
		help 
			If defined, the chinese sorting support is activated in Soul.
	
	endmenu # Soul 
		
endmenu # Exceptionnel Config

