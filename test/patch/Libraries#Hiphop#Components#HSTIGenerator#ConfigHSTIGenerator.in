
config HSTI_GENERATOR_MAIN_ATSPEC_DIR
	string "HSTI_GENERATOR_MAIN_ATSPEC_DIR"
	default "Hiphop/Components/SoftAT/ATSpec"
	help
		Main ATSpec directory.
		Path relative to top directory.

config HSTI_GENERATOR_USE_EXTRA_ATSPEC_DIRS
	bool "HSTI_GENERATOR_USE_EXTRA_ATSPEC_DIRS"
	default n

	config HSTI_GENERATOR_EXTRA_ATSPEC_DIRS
		string "HSTI_GENERATOR_EXTRA_ATSPEC_DIRS"
		default ""
		depends on HSTI_GENERATOR_USE_EXTRA_ATSPEC_DIRS
		help
			Extra ATSpec directories.
			Path relative to top directory.

config HSTI_GENERATOR_USE_EXTRA_ATPARAM_FILES
	bool "HSTI_GENERATOR_USE_EXTRA_ATPARAM_FILES"
	default n

	config HSTI_GENERATOR_EXTRA_ATPARAM_FILES
		string "HSTI_GENERATOR_EXTRA_ATPARAM_FILES"
		default ""
		depends on HSTI_GENERATOR_USE_EXTRA_ATPARAM_FILES
		help
			Extra ATParam files.
			Path relative to top directory.

config HSTI_GENERATOR_USE_MULTI_TARGET
	bool "HSTI_GENERATOR_USE_MULTI_TARGET"
	default n

	config HSTI_GENERATOR_MULTI_TARGET
		string "HSTI_GENERATOR_MULTI_TARGET"
		default ""
		depends on HSTI_GENERATOR_USE_MULTI_TARGET
		help
			Multi target name (ex : GSM).

