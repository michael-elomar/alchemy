diff --git a/Parrot.mk b/Parrot.mk
index 0de19d5..a85cee0 100644
--- a/Parrot.mk
+++ b/Parrot.mk
@@ -1,3 +1,5 @@
+include hardware/parrot/HSTILib/Build/Android/HSTILIB_Flags.mk
+
 LOCAL_SRC_FILES += \
 	Jerk/java/com/parrot/hsti/service/IHSTIHostService.aidl             \
 	Jerk/java/com/parrot/hsti/service/IHSTITargetService.aidl           \
@@ -17,4 +19,50 @@ LOCAL_SRC_FILES += \
 	Jerk/java/com/parrot/platform/connectivity/net/IUsbModemService.aidl \
 	Jerk/java/com/parrot/platform/connectivity/net/IBluetoothDataServiceCallback.aidl \
 	Jerk/java/com/parrot/platform/connectivity/net/IBluetoothDataService.aidl
-	
+
+# Without alchemy, lucie takes care of everything before calling us
+ifeq ("$(BUILD_USE_ALCHEMY)","true")
+
+# List of file to generate/copy/compile
+HSTI_JAVA_GENERATED_FILE_LIST := \
+	ATParams.java \
+	Cmd.java \
+	Command.java \
+	Event.java \
+	Evt.java \
+	FactoryCommand.java \
+	FactoryEvent.java \
+
+# Where the generated java files will be copied for compilation
+#HSTI_JAVA_GENERATED_DIR := \
+#	$(call intermediates-dir-for,JAVA_LIBRARIES,framework)/src/Jerk/java/com/parrot/hsti/generated
+
+# We can NOT put generated files outside source tree for now because it is integrated in the framework.
+# When Jerk will be outside the framework lets discuss again...
+# This avoids the message : 'You have tried to change the API from what has been previously approved'
+HSTI_JAVA_GENERATED_DIR := \
+	$(LOCAL_PATH)/Jerk/java/com/parrot/hsti/generated
+
+# Where the generated java files are actually generated by alchemy
+HSTI_JAVA_GENERATED_DIR_ORIG := \
+	$(TARGET_OUT_INTERMEDIATES)/alchemy/build/hsti-generator/java
+
+# Full list of files
+HSTI_JAVA_GENERATED_FILES := \
+	$(addprefix $(HSTI_JAVA_GENERATED_DIR)/,$(HSTI_JAVA_GENERATED_FILE_LIST))
+HSTI_JAVA_GENERATED_FILES_ORIG := \
+	$(addprefix $(HSTI_JAVA_GENERATED_DIR_ORIG)/,$(HSTI_JAVA_GENERATED_FILE_LIST))
+
+# Dependency to generate java files by alchemy
+$(HSTI_JAVA_GENERATED_FILES_ORIG) : $(HSTILIB_GENERATED_DONE_FILE)
+
+# Rule to copy generated files at the correct place
+$(HSTI_JAVA_GENERATED_FILES): $(HSTI_JAVA_GENERATED_DIR)/%: $(HSTI_JAVA_GENERATED_DIR_ORIG)/%
+	@mkdir -p $(dir $@)
+	@cp -af $< $@
+
+# Add final files to compilation list
+LOCAL_GENERATED_SOURCES += \
+	$(HSTI_JAVA_GENERATED_FILES)
+
+endif
