diff --git a/core/src/generic/backtrace.c b/core/src/generic/backtrace.c
index a588c80..4fdf374 100644
--- a/core/src/generic/backtrace.c
+++ b/core/src/generic/backtrace.c
@@ -8,10 +8,289 @@
 ***************************************************************************
 */
 
+#define _GNU_SOURCE
 #include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
 
 #include "parrotOS.h"
 
+/* stack frame */
+struct backtrace_frame {
+	void *pc;			/* frame pc */
+	char *bin;			/* binary file */
+	char *file;			/* source file + line number */
+	char *func;			/* function name */
+};
+
+/* backtrace stack */
+struct backtrace_stack {
+	struct backtrace_frame *frames;
+	size_t count;
+};
+
+#ifdef OS_LINUX
+
+#include <sys/wait.h>
+
+struct map_info {
+	unsigned int start;
+	unsigned int end;
+	char *name;
+	struct map_info *next;
+};
+
+/* Find the containing map info for the pc */
+static struct map_info *find_mapinfo(struct map_info *head,
+				     unsigned int address)
+{
+	struct map_info *mi = head;
+
+	while (mi) {
+		if ((address >= mi->start) && (address < mi->end))
+			return mi;
+		mi = mi->next;
+	}
+
+	return NULL;
+}
+
+/**
+ * TODO : handle 64-bit...
+ * address           perms offset  dev   inode   pathname
+ * 00400000-004e0000 r-xp 00000000 08:01 262151  /bin/bash
+ * 40000000-40013000 r-xp 00000000 03:0c 4165    /lib/ld-2.2.4.so
+ * 7f8789838000-7f8789844000 r-xp 00000000 08:01 790833  /lib/x86_64-linux-gnu/libnss_files-2.15.so
+ */
+static struct map_info *parse_maps_line(const char *line, size_t length)
+{
+	struct map_info *mi;
+	const char *name;
+
+	if (!line)
+		return NULL;
+
+	/* skip incomplete lines */
+	if (length < 50)
+		return NULL;
+
+	/* skip lines without execute permissions */
+	if (line[20] != 'x')
+		return NULL;
+
+	/* allocate mapinfo */
+	mi = calloc(1, sizeof(struct map_info));
+	if (!mi)
+		return NULL;
+
+	/* get name after spaces */
+	name = line + 49;
+	while (*name == ' ' && *name != '\0')
+		name++;
+
+	mi->start = strtoul(line, NULL, 16);
+	mi->end = strtoul(line + 9, NULL, 16);
+	mi->name = strdup(name);
+
+	return mi;
+}
+
+static int read_proc_maps(struct backtrace_stack *stack)
+{
+	struct map_info *head, *mi, *tmp;
+	size_t i;
+	char line[1024];
+	size_t length;
+	FILE *fp;
+
+	head = NULL;
+
+	/* parse /proc/self/maps */
+	fp = fopen("/proc/self/maps", "r");
+	if (!fp)
+		return -errno;
+
+	/* read lines and populate map infos list */
+	while (fgets(line, 1024, fp)) {
+		/* remove final '\n' from line */
+		length = strlen(line);
+		if (length > 0 && line[length - 1] == '\n') {
+			line[length - 1] = '\0';
+			length--;
+		}
+
+		/* parse line */
+		mi = parse_maps_line(line, length);
+		if (!mi)
+			continue;
+
+		/* add map info to list */
+		mi->next = head;
+		head = mi;
+	}
+	fclose(fp);
+
+	/* get maping */
+	for (i = 0; i < stack->count; i++) {
+		mi = find_mapinfo(head, (unsigned int)stack->frames[i].pc);
+		if (mi) {
+			/* only calculate the relative offset for
+			 * shared libraries */
+			if (strstr(mi->name, ".so")) {
+				stack->frames[i].pc = (void *)(
+					(uintptr_t)stack->frames[i].pc - mi->start);
+			}
+
+			stack->frames[i].bin = strdup(mi->name);
+		}
+	}
+
+	/* free map info list */
+	mi = head;
+	while (mi) {
+		tmp = mi->next;
+		free(mi->name);
+		free(mi);
+		mi = tmp;
+	}
+
+	return 0;
+}
+
+#define ADDR2LINE_BUFF_SIZE 256
+static int addr2line(struct backtrace_frame *frame)
+{
+	int ret;
+	__pid_t pid;
+	int pfds[2];
+	int status;
+	char *argv[7];
+	char *eol, *pos;
+	char buffer[ADDR2LINE_BUFF_SIZE];
+	size_t i, len, nblines;
+
+	/* build command argument */
+	argv[0] = strdup("/usr/bin/addr2line");
+	argv[1] = strdup("-f");
+	argv[2] = strdup("-C");
+	argv[3] = strdup("-e");
+	argv[4] = strdup(frame->bin);
+	ret = asprintf(&argv[5], "0x%08x", (unsigned int)frame->pc);
+	if (ret < 0)
+		goto error;
+
+	argv[6] = NULL;
+
+	/* create a pipe */
+	ret = pipe(pfds);
+	if (ret < 0)
+		goto error;
+
+	/* fork process */
+	pid = fork();
+	if (pid == 0) {
+		/* child process */
+
+		/* duplicate pipe's writing end into stdout */
+		dup2(pfds[1], STDOUT_FILENO);
+
+		close(pfds[1]);
+		close(pfds[0]);
+
+		/* start execution */
+		execv(argv[0], argv);
+		_exit(127);
+	}
+	/* parent process */
+
+	/* close write pipe*/
+	close(pfds[1]);
+
+	/* check fork succeed */
+	if (pid < 0) {
+		close(pfds[0]);
+		goto error;
+	}
+
+	len = 0;
+	nblines = 0;
+	while (1) {
+
+		/* read from pipe in blocking mode */
+		do {
+			ret = read(pfds[0], &buffer[len],
+				   sizeof(buffer) - len - 1);
+		} while (ret < 0 && errno == EINTR);
+
+		/* stop reading on error or end of file */
+		if (ret == 0 || ret < 0)
+			break;
+
+		len += ret;
+		buffer[len] = '\0';
+
+		pos = buffer;
+		while (1) {
+			/* find end of lines */
+			eol = strchr(pos, '\n');
+			if (!eol)
+				break;
+
+			*eol = '\0';
+
+			/* addr2line generates 2 lines per address
+			 * function name
+			 * file name */
+
+			if (nblines % 2 == 0) {
+				if (strcmp(pos, "??") == 0) {
+					asprintf(&frame->func, "0x%08x",
+					(unsigned int)frame->pc);
+				} else {
+					frame->func = strdup(pos);
+				}
+			} else {
+				if (strcmp(pos, "??:0") != 0)
+					frame->file = strdup(pos);
+			}
+
+			nblines++;
+			*eol = '\n';
+			pos = eol + 1;
+		}
+
+		len -=  pos - buffer;
+		if (len > 0)
+			memmove(buffer, pos, len - (pos - buffer));
+	}
+
+	/* close read pipe */
+	close(pfds[0]);
+
+	/* wait end of pid */
+	waitpid(pid, &status, 0);
+	ret = frame->func ? 0 : -ENOENT;
+
+error:
+	/* free args*/
+	for (i = 0; i < sizeof(argv) / sizeof(argv[0]); i++)
+		free(argv[i]);
+	return ret;
+}
+
+#else
+
+static int read_proc_maps(struct backtrace_stack *stack)
+{
+	return 0;
+}
+
+static int addr2line(struct backtrace_frame *frame)
+{
+	return 0;
+}
+
+#endif // OS_LINUX
 
 #define PAL_CALLSTACK_MAXDEPTH 20
 
@@ -96,13 +375,56 @@ int pal_backtrace(void **buffer, int size)
 
 void pal_backtrace_display(int max)
 {
+	struct backtrace_stack stack;
 	int count = pal_backtrace(backtrace_buffer, max);
-	int i;
+	size_t i;
+
+	stack.count = count - PAL_CALLSTACK_SKIP;
+	stack.frames = calloc(stack.count, sizeof(struct backtrace_frame));
+	if (!stack.frames) {
+		return;
+	}
+
+	for (i = 0; i < stack.count; i++)
+		stack.frames[i].pc = backtrace_buffer[PAL_CALLSTACK_SKIP + i];
+
+	/* read proc maps and filled up binary file for each frames */
+	read_proc_maps(&stack);
+
+#if defined(__arm__)
+	/* on arm (cross platform) target do not resolve address function name
+	 * addr2line is not in target and binary is generally stripped !*/
+#else
