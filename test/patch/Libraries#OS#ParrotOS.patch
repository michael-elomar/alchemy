+#endif
 
 	/* + 1 for skipping this function */
-	for (i = PAL_CALLSTACK_SKIP + 1; i < count; i++) {
-		PLOGC(PAL_ASSERT, "\t%p\n", backtrace_buffer[i]);
+	for (i = 1; i < stack.count; i++) {
+		char *bin_name = NULL;
+
+		/* binary name without path */
+		if (stack.frames[i].bin) {
+			bin_name = strrchr(stack.frames[i].bin, '/');
+			if (bin_name)
+				bin_name++;
+		}
+
+		PLOGC(PAL_ASSERT, "  #%02d  pc 0x%08x %s %s %s",
+			  i-1, (unsigned int)stack.frames[i].pc,
+			  bin_name ? bin_name : "",
+			  stack.frames[i].func ? stack.frames[i].func : "",
+			  stack.frames[i].file ? stack.frames[i].file : "");
+	}
+
+	/* free backtrace */
+	for (i = 0; i < stack.count; i++) {
+		free(stack.frames[i].func);
+		free(stack.frames[i].file);
+		free(stack.frames[i].bin);
 	}
+	free(stack.frames);
 }
 
